# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_SUPABASE_URL: Your Supabase Project URL
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Your Supabase Anon/Public Key
VITE_SUPABASE_ANON_KEY="your-anon-key"

# SUPABASE_SERVICE_ROLE_KEY: Required for server-side Supabase admin operations
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# PADDLE_VENDOR_ID: Your Paddle Vendor ID
PADDLE_VENDOR_ID="your-vendor-id"

# PADDLE_API_KEY: Your Paddle API Key
PADDLE_API_KEY="your-paddle-api-key"

# VITE_PADDLE_CLIENT_TOKEN: Your Paddle client-side SDK token (e.g. test_xxxxxxxx for sandbox)
VITE_PADDLE_CLIENT_TOKEN="test_xxxxxxxxxxxxxxxxxxxxxxxx"

# VITE_PADDLE_ENVIRONMENT: Paddle environment (sandbox or production)
VITE_PADDLE_ENVIRONMENT="sandbox"

# VITE_PADDLE_PRICE_MONTHLY: Price ID for the monthly Pro plan (e.g., pri_01hs...)
VITE_PADDLE_PRICE_MONTHLY="pri_01hs_monthly_test_price"

# VITE_PADDLE_PRICE_YEARLY: Price ID for the yearly Pro plan (e.g., pri_01hs...)
VITE_PADDLE_PRICE_YEARLY="pri_01hs_yearly_test_price"
